# Based on prometheus-community/windows_exporter's .editorconfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
tab_width = 4

[{*.go,go.mod,go.sum,Makefile}]
indent_style = tab

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[{*.sh,testdata/fake-smartctl}]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[{*.tsv,devices.tsv}]
indent_style = tab

# Third-party data kept byte-identical to its source.
[{testdata/scenario/*.json,testdata/golden/*.prom,grafana/*.json}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
